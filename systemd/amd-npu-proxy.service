[Unit]
Description=AMD NPU API on 127.0.0.1:52625 (proxy to FastFlowLM; refuses browser pages and model downloads)
Documentation=https://github.com/AlanRoman117/omarchy-amd-npu
PartOf=amd-npu.service
After=amd-npu.service

[Service]
Environment=AMD_NPU_ALLOWED_ORIGINS=
EnvironmentFile=-%E/amd-npu/server.env
ExecStart=/usr/bin/python3 %h/.local/share/amd-npu/proxy.py
Restart=on-failure
RestartSec=2
# The proxy only needs Python, its own file, `flm list` and loopback TCP.
NoNewPrivileges=yes
PrivateUsers=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ProtectProc=invisible
RemoveIPC=yes
