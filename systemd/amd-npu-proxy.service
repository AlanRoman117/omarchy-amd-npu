[Unit]
Description=AMD NPU API on 127.0.0.1:52625 (proxy to FastFlowLM; refuses browser pages and model downloads)
Documentation=https://github.com/AlanRoman117/omarchy-amd-npu
PartOf=amd-npu.service
After=amd-npu.service amd-npu-proxy.socket
# The port comes from amd-npu-proxy.socket, which keeps it bound while this service restarts.
Requires=amd-npu-proxy.socket

[Service]
Environment=AMD_NPU_ALLOWED_ORIGINS=
EnvironmentFile=-%E/amd-npu/server.env
ExecStart=/usr/bin/python3 %h/.local/share/amd-npu/proxy.py
Restart=on-failure
TimeoutStopSec=5
RestartSec=2
# The proxy only needs Python, its own file, `flm list` and loopback TCP.
NoNewPrivileges=yes
PrivateUsers=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
# The proxy needs no devices. Its `flm list` (the downloaded-model check) then can't open the NPU
# next to the server, which FastFlowLM 1.0.9 otherwise does for every command.
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ProtectProc=invisible
