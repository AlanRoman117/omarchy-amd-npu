[Unit]
Description=Whisper large-v3-turbo on the AMD XDNA2 NPU (FastFlowLM), OpenAI API on 127.0.0.1:52625
Documentation=https://github.com/AlanRoman117/omarchy-npu-dictation

[Service]
ExecStart=/usr/bin/flm serve --asr 1 --host 127.0.0.1 --port 52625 --quiet
LimitMEMLOCK=infinity
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
