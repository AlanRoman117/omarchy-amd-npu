[Unit]
Description=AMD NPU server (FastFlowLM): Whisper for dictation plus an optional local LLM, API on 127.0.0.1:52625
Documentation=https://github.com/AlanRoman117/omarchy-amd-npu

[Service]
# Defaults: Whisper only. `amd-npu load/unload` rewrites server.env and restarts the service.
# An empty FLM_LLM expands to no argument at all, so the server starts with Whisper alone.
# CORS off: browser fetches that send JSON (and so need a preflight) are refused. FLM_CORS=1 in
# server.env turns it back on for browser chat UIs.
Environment=FLM_LLM= FLM_ASR=1 FLM_CTX=-1 FLM_CORS=0
EnvironmentFile=-%h/.config/amd-npu/server.env
ExecStart=/usr/bin/flm serve $FLM_LLM --asr ${FLM_ASR} --ctx-len ${FLM_CTX} --cors ${FLM_CORS} --host 127.0.0.1 --port 52625 --quiet
LimitMEMLOCK=infinity
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
