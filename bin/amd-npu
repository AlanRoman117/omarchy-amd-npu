#!/bin/bash

# amd-npu: dictation and small local LLMs on the AMD XDNA2 NPU (FastFlowLM).
# Whisper serves Omarchy's Voxtype dictation; an optional LLM can run next to
# it (share) or take the NPU alone (exclusive, dictation falls back to CPU).
#
# Usage: amd-npu <command> [args]   (amd-npu help)

set -euo pipefail
# Local API calls must never go through an HTTP proxy from the environment.
export no_proxy="127.0.0.1,localhost${no_proxy:+,$no_proxy}" NO_PROXY="127.0.0.1,localhost${NO_PROXY:+,$NO_PROXY}"

VERSION=0.14.0
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

PORT=52625
# Python by absolute path: a PATH with mise shims first doubles the processes per call.
PY=/usr/bin/python3; [[ -x $PY ]] || PY=python3
URL="http://127.0.0.1:$PORT"
WHISPER="whisper-v3:turbo"
# The one embedding model FastFlowLM offers (EmbeddingGemma 300M); loaded with `amd-npu embed on`.
EMBED_MODEL=embed-gemma:300m
FLM_MODELS="$CONFIG_HOME/flm/models"
WHISPER_DIR="$FLM_MODELS/Whisper-V3-Turbo-NPU2"
UNIT="amd-npu.service"
UNIT_FILE="$CONFIG_HOME/systemd/user/$UNIT"
# Clients talk to the proxy on $PORT; FastFlowLM itself listens on 6669, which browsers refuse.
PROXY_UNIT="amd-npu-proxy.service"
PROXY_UNIT_FILE="$CONFIG_HOME/systemd/user/$PROXY_UNIT"
# Holds port 52625 for this account through proxy/server restarts and while released.
PROXY_SOCKET="amd-npu-proxy.socket"
PROXY_SOCKET_FILE="$CONFIG_HOME/systemd/user/$PROXY_SOCKET"
# Fixed path: the unit runs %h/.local/share/amd-npu/proxy.py (systemd has no data-home specifier).
PROXY_DIR="$HOME/.local/share/amd-npu"
GUARD="$PROXY_DIR/dictation-guard.py"
LEGACY_UNIT="flm-asr.service"
STATE_DIR="$CONFIG_HOME/amd-npu"
SERVER_ENV="$STATE_DIR/server.env"
VOXTYPE_CONFIG="$CONFIG_HOME/voxtype/config.toml"
# Voxtype's [whisper] values before amd-npu first changed them (restored by disable/remove),
# plus the first and the latest full copies of its config.
VOX_STATE="$STATE_DIR/voxtype"
VOX_ORIGINAL="$VOX_STATE/original-whisper.json"
# Present while amd-npu has switched Voxtype to its CPU model for an NPU-only LLM.
VOX_EXCLUSIVE="$VOX_STATE/exclusive"
# F9 as a toggle: Omarchy loads every .lua in this directory after its own and the user's bindings
# (default/hypr/toggles.lua), the same mechanism its own `omarchy-hyprland-toggle` flags use.
F9_TOGGLE="$HOME/.local/state/omarchy/toggles/hypr/amd-npu-f9-toggle.lua"
# Present while the NPU is released (server stopped and disabled until `amd-npu resume`).
RELEASED="$STATE_DIR/released"
PLUGIN_ID="alanroman117.amd-npu"
PACKAGES=(xrt xrt-plugin-amdxdna fastflowlm)

# The NPU runtime pins model weights, so the service needs an unlimited memlock limit.
# One PAM entry naming only this user lifts the ceiling for their session (and user service
# manager); amd-npu.service then sets LimitMEMLOCK=infinity for itself. Nothing else changes.
MEMLOCK_LIMITS="/etc/security/limits.d/90-amd-npu-memlock.conf"
# Written by 0.1-0.7 and applying to every account; install and remove delete them.
LEGACY_MEMLOCK=(/etc/systemd/system/user@.service.d/90-amd-npu-memlock.conf /etc/systemd/user.conf.d/90-amd-npu-memlock.conf)

# --- output helpers ---------------------------------------------------------

ok() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
bad() { printf '  \033[31m✗\033[0m %s\n' "$*"; }
note() { printf '  \033[33m•\033[0m %s\n' "$*"; }
step() { printf '\n\033[1m%s\033[0m\n' "$*"; }
die() { printf '\033[31mError:\033[0m %s\n' "$*" >&2; exit 1; }

YES=0
FORCE=0
confirm() {
  (( YES )) && return 0
  if command -v gum >/dev/null && [[ -t 0 ]]; then
    gum confirm "$1"
  else
    read -r -p "$1 [y/N] " reply
    [[ $reply == [yY]* ]]
  fi
}

notify() {
  if command -v omarchy-notification-send >/dev/null; then
    omarchy-notification-send "$1" "$2" -t 8000 >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null; then
    notify-send "$1" "$2" >/dev/null 2>&1 || true
  fi
}

refresh_widget() {
  command -v omarchy-shell >/dev/null && omarchy-shell "$PLUGIN_ID" refresh >/dev/null 2>&1 || true
}

# --- hardware and state probes ---------------------------------------------

# Prints "xdna2", "xdna1" or "none" from the PCI bus (no lspci dependency).
npu_generation() {
  local dev vendor device
  for dev in /sys/bus/pci/devices/*; do
    vendor=$(<"$dev/vendor") device=$(<"$dev/device")
    [[ $vendor == 0x1022 ]] || continue
    case $device in
      0x17f0) echo xdna2; return ;;
      0x1502) echo xdna1; return ;;
    esac
  done
  echo none
}

packages_missing() {
  local pkg missing=()
  for pkg in "${PACKAGES[@]}"; do
    pacman -Q "$pkg" &>/dev/null || missing+=("$pkg")
  done
  echo "${missing[*]}"
}

server_up() {
  [[ $(curl -s -m 2 -o /dev/null -w '%{http_code}' "$URL/api/version" 2>/dev/null) == 200 ]]
}

wait_for_server() {
  local i
  for i in $(seq 1 60); do server_up && return 0; sleep 1; done
  return 1
}

# Reads or edits [whisper] (or the section in VOX_SECTION) in Voxtype's config. Values are read with a TOML parser; edits keep
# every other line as it is, go to the file a symlink points at (dotfile managers keep working),
# and land through a temp file and an atomic rename.
#   voxtype_cfg get <key>             the value as text (empty if unset)
#   voxtype_cfg dump                  the keys amd-npu manages, as typed JSON
#   voxtype_cfg set k=str k:=json -k  set a string, set a typed JSON value, remove a key
voxtype_cfg() {
  # Reads come from the snapshot vox_cache_load took (one Python start instead of one per value);
  # any write drops it.
  if [[ ${1:-} == get && $VOX_CACHE_LOADED == 1 ]]; then
    printf '%s\n' "${VOX_CACHE[${VOX_SECTION:-whisper}.$2]-}"
    return 0
  fi
  [[ ${1:-} == set ]] && VOX_CACHE_LOADED=0
  "$PY" - "$VOXTYPE_CONFIG" "$@" <<'PY'
import json, os, re, sys, tempfile, tomllib
path, op, args = os.path.realpath(sys.argv[1]), sys.argv[2], sys.argv[3:]
SECTION = os.environ.get("VOX_SECTION") or "whisper"
MANAGED = ("mode", "backend", "remote_endpoint", "remote_model", "remote_timeout_secs")
text = open(path).read()
if op in ("get", "dump"):
    try:
        table = tomllib.loads(text).get(SECTION, {})
    except tomllib.TOMLDecodeError:
        table = {}
    if op == "dump":
        print(json.dumps({k: table[k] for k in MANAGED if k in table}))
    else:
        v = table.get(args[0])
        print("" if v is None else (str(v).lower() if isinstance(v, bool) else str(v)))
    sys.exit(0)
HEADER = re.compile(r'^\s*\[\s*([^\]]+?)\s*\]\s*(#.*)?$')
KEY = re.compile(r'^\s*([A-Za-z0-9_]+)\s*=')
want, drop = {}, set()
for a in args:
    if a.startswith("-"):
        drop.add(a[1:])
    elif ":=" in a:
        k, v = a.split(":=", 1)
        want[k] = json.loads(v)
    else:
        k, v = a.split("=", 1)
        want[k] = v
def fmt(k, v):
    if isinstance(v, bool):
        return f"{k} = {str(v).lower()}"
    if isinstance(v, (int, float)):
        return f"{k} = {v}"
    return f"{k} = {json.dumps(str(v))}"  # a JSON string is a valid TOML basic string
out, section, seen, found = [], "", set(), False
def flush():
    for k, v in want.items():
        if k not in seen:
            out.append(fmt(k, v))
            seen.add(k)
for line in text.splitlines():
    h = HEADER.match(line)
    if h:
        if section == SECTION:
            flush()
        section = h.group(1)
        found = found or section == SECTION
    elif section == SECTION:
        m = KEY.match(line)
        if m and m.group(1) in drop:
            continue
        if m and m.group(1) in want:
            line = fmt(m.group(1), want[m.group(1)])
            seen.add(m.group(1))
    out.append(line)
if section == SECTION:
    flush()
if not found and want:
    out += ["", f"[{SECTION}]"]
    flush()
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".config.toml.")
with os.fdopen(fd, "w") as f:
    f.write("\n".join(out) + "\n")
os.chmod(tmp, os.stat(path).st_mode & 0o7777)
os.replace(tmp, path)
PY
}

# One read of Voxtype's [whisper] and [output] values for the rest of this command, in the main shell
# so that $(voxtype_cfg get ...) subshells see it. Formatted like `voxtype_cfg get`.
declare -A VOX_CACHE=()
VOX_CACHE_LOADED=0
vox_cache_load() {
  VOX_CACHE=()
  VOX_CACHE_LOADED=0
  [[ -f $VOXTYPE_CONFIG ]] || return 0
  local k v
  while IFS= read -r -d '' k && IFS= read -r -d '' v; do VOX_CACHE[$k]=$v; done < <("$PY" - "$VOXTYPE_CONFIG" <<'PY'
import os, sys, tomllib
try:
    with open(os.path.realpath(sys.argv[1]), "rb") as f:
        config = tomllib.load(f)
except (OSError, tomllib.TOMLDecodeError):
    config = {}
for section in ("whisper", "output"):
    table = config.get(section, {})
    for key, value in (table.items() if isinstance(table, dict) else []):
        if isinstance(value, (dict, list)):
            continue
        text = str(value).lower() if isinstance(value, bool) else str(value)
        sys.stdout.write(f"{section}.{key}\0{text.replace(chr(0), '')}\0")
PY
)
  VOX_CACHE_LOADED=1
}

# Voxtype 1.1 renamed [whisper] backend to mode; when both are set, mode wins (tested with 1.1.1:
# mode = "local" + backend = "remote" transcribes locally). Read mode first, then the old name.
voxtype_backend() {
  [[ -f $VOXTYPE_CONFIG ]] || { echo "-"; return; }
  local m b
  m=$(voxtype_cfg get mode)
  [[ -n $m ]] && { echo "$m"; return; }
  b=$(voxtype_cfg get backend)
  echo "${b:-local}"
}

# Voxtype sends audio to this server (not just to some remote server).
voxtype_on_npu() {
  [[ $(voxtype_backend) == remote && $(voxtype_cfg get remote_endpoint) == "$URL" ]]
}

# Keeps the first and the latest copy of Voxtype's config, dereferenced, in amd-npu's own folder.
voxtype_backup() {
  mkdir -p "$VOX_STATE"
  [[ -f $VOX_STATE/config.toml.first ]] || cp -L --preserve=mode,timestamps "$VOXTYPE_CONFIG" "$VOX_STATE/config.toml.first"
  cp -L --preserve=mode,timestamps "$VOXTYPE_CONFIG" "$VOX_STATE/config.toml.latest"
}

# Records Voxtype's own [whisper] values the first time amd-npu changes them.
voxtype_save_original() {
  [[ -f $VOX_ORIGINAL ]] && return 0
  # Already on the NPU with nothing recorded: set up by a version before 0.8, so the user's own
  # values are unknown. Recording these would make disable "restore" the NPU settings.
  voxtype_on_npu && return 0
  # Mid NPU-only round trip: the current values are amd-npu's own, not the user's.
  [[ -f $VOX_EXCLUSIVE ]] && return 0
  mkdir -p "$VOX_STATE"
  voxtype_cfg dump >"$VOX_ORIGINAL"
}

# A Voxtype remote timeout already at 180 s or more (integer or decimal) is left alone.
timeout_ok() { [[ $1 =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk -v t="$1" 'BEGIN { exit !(t >= 180) }'; }

voxtype_changes_text() {
  echo "  Voxtype's config ($VOXTYPE_CONFIG), [whisper] section:"
  echo "    mode = \"remote\", remote_endpoint = \"$URL\", remote_model = \"$WHISPER\""
  [[ -n $(voxtype_cfg get backend) ]] && echo "    the old 'backend' line is removed (Voxtype 1.1 renamed it to 'mode')"
  timeout_ok "$(voxtype_cfg get remote_timeout_secs)" || echo "    remote_timeout_secs = 180 (long dictations take up to ~1 min to transcribe)"
  echo "  [output] section: pre_recording_command runs amd-npu's dictation guard as each recording"
  echo "    starts. It cancels the recording if another account holds port $PORT (any command you"
  echo "    already have there runs after it)."
  echo "  Your current values are saved, and 'amd-npu disable' or 'remove' puts them back."
}

# Point Voxtype at the NPU ("remote") or its CPU model ("local", exclusive mode). Backs up and
# restarts Voxtype only when something changes. Callers ask for consent first (see enable).
voxtype_use() {
  [[ -f $VOXTYPE_CONFIG ]] || return 0
  if [[ $1 == remote ]]; then
    voxtype_on_npu && return 0
    voxtype_save_original
    voxtype_backup
    local args=(mode=remote -backend remote_endpoint="$URL" remote_model="$WHISPER")
    timeout_ok "$(voxtype_cfg get remote_timeout_secs)" || args+=(remote_timeout_secs:=180)
    voxtype_cfg set "${args[@]}"
  else
    [[ $(voxtype_backend) == local ]] && return 0
    voxtype_save_original
    voxtype_backup
    voxtype_cfg set mode=local -backend
  fi
  systemctl --user restart voxtype.service 2>/dev/null || true
}

# Puts back the [whisper] values Voxtype had before amd-npu. Older versions didn't record them;
# then Voxtype goes back to its CPU model, as before.
voxtype_restore() {
  [[ -f $VOXTYPE_CONFIG ]] || return 0
  if [[ ! -f $VOX_ORIGINAL ]]; then
    voxtype_use local
    return 0
  fi
  voxtype_backup
  local k v args=()
  for k in mode backend remote_endpoint remote_model remote_timeout_secs; do
    v=$(jq -c --arg k "$k" 'if has($k) then .[$k] else empty end' "$VOX_ORIGINAL")
    if [[ -n $v ]]; then args+=("$k:=$v"); else args+=("-$k"); fi
  done
  voxtype_cfg set "${args[@]}"
  # Cleared, so a later enable records whatever the user has set by then.
  rm -f "$VOX_ORIGINAL" "$VOX_EXCLUSIVE"
  systemctl --user restart voxtype.service 2>/dev/null || true
}

# NPU-only LLM: Voxtype moves to its CPU model only if it was on the NPU, and only then comes back.
voxtype_exclusive_on() {
  voxtype_on_npu || { note "Voxtype isn't using the NPU, so it's left as it is"; return 1; }
  voxtype_use local
  mkdir -p "$VOX_STATE" && touch "$VOX_EXCLUSIVE"
}

voxtype_exclusive_off() {
  [[ -f $VOX_EXCLUSIVE ]] || return 1
  voxtype_use remote
  rm -f "$VOX_EXCLUSIVE"
}

# The dictation guard: Voxtype's [output] pre_recording_command runs lib/dictation-guard.py as each
# recording starts, which cancels it unless this account holds port 52625 (HANCORE's review: the
# port is plain HTTP, so Voxtype can't tell who answers). A pre_recording_command the user already
# had runs after it, and comes back alone when the guard is removed.
GUARD_RE='^python3 [^;]*dictation-guard\.py(; )?'
guard_cmd() { printf 'python3 %q' "$GUARD"; }
voxtype_guard_on() {
  [[ -f $VOXTYPE_CONFIG ]] || return 0
  local cur new; cur=$(VOX_SECTION=output voxtype_cfg get pre_recording_command)
  [[ $cur =~ $GUARD_RE ]] && return 0
  voxtype_backup
  new=$(guard_cmd); [[ -n $cur ]] && new="$new; $cur"
  VOX_SECTION=output voxtype_cfg set pre_recording_command="$new"
  systemctl --user restart voxtype.service 2>/dev/null || true
}
voxtype_guard_off() {
  [[ -f $VOXTYPE_CONFIG ]] || return 0
  local cur rest; cur=$(VOX_SECTION=output voxtype_cfg get pre_recording_command)
  [[ $cur =~ $GUARD_RE ]] || return 0
  voxtype_backup
  rest=${cur#"${BASH_REMATCH[0]}"}
  if [[ -n $rest ]]; then VOX_SECTION=output voxtype_cfg set pre_recording_command="$rest"
  else VOX_SECTION=output voxtype_cfg set -pre_recording_command; fi
  systemctl --user restart voxtype.service 2>/dev/null || true
}
guard_installed() { [[ -f $VOXTYPE_CONFIG && $(VOX_SECTION=output voxtype_cfg get pre_recording_command) =~ $GUARD_RE ]]; }

# Who listens where our clients connect: "other" if any listener that would get 127.0.0.1:<port>
# traffic (loopback, 0.0.0.0, ::, ::1, ::ffff:127.0.0.1) belongs to another account, else "own"
# or "none".
port_owner() {
  local p; p=$(printf '%04X' "$1")
  awk -v uid="$(id -u)" -v p="$p" '
    BEGIN { split("0100007F 00000000 00000000000000000000000000000000 00000000000000000000000001000000 0000000000000000FFFF00000100007F", a, " ")
            for (i in a) want[a[i] ":" p] = 1 }
    FNR > 1 && ($2 in want) && $4 == "0A" { if ($8 == uid) own = 1; else other = 1 }
    END { print (other ? "other" : (own ? "own" : "none")) }' /proc/net/tcp /proc/net/tcp6 2>/dev/null
}

# --- NPU health -------------------------------------------------------------
# A second program on the NPU can crash the amdxdna driver (7.2 kernels): waking the suspended NPU
# replays flm's hardware contexts in the caller, and a kill arriving mid-resume oopses in
# xdna_mailbox_alloc_channel. Afterwards every open or close of the device hangs, processes become
# unkillable and shutdown stalls. None of the checks below open the device.

# Why the driver looks stuck, or nothing: one of this user's threads asleep uninterruptibly inside
# the driver, or a driver crash in this boot's kernel log.
npu_wedge_reason() {
  local line
  line=$(ps -L -u "$(id -u)" -o pid=,stat=,wchan:40=,comm= 2>/dev/null |
    awk '$2 ~ /^D/ && $3 ~ /^(amdxdna|aie2|xdna|rpm_resume)/ { print $4 " (pid " $1 ") is stuck in the NPU driver (" $3 ")"; exit }')
  [[ -n $line ]] && { echo "$line"; return; }
  if journalctl -k -b 0 --no-pager -q -g 'xdna_mailbox|\[amdxdna\]' 2>/dev/null |
    grep -qE 'BUG:|Oops|rescuer kthread for wq "xdna_mailbox"|RIP: .*\[amdxdna\]'; then
    echo "the kernel reported an NPU driver crash in this boot"
  fi
}

# Other processes of this user holding an NPU device node ("pid:comm" per line); FastFlowLM and
# anything in amd-npu's own units don't count.
npu_holders() {
  local f pid
  # Other users' /proc entries are unreadable, so find always "fails"; that's expected.
  { find /proc/[0-9]*/fd -maxdepth 1 -lname "${NPU_NODE_GLOB:-/dev/accel/accel*}" 2>/dev/null || true; } | while read -r f; do
    pid=${f#/proc/}; pid=${pid%%/*}
    grep -q 'amd-npu' "/proc/$pid/cgroup" 2>/dev/null && continue
    echo "$pid:$(cat "/proc/$pid/comm" 2>/dev/null)"
  done | sort -u
}

# "ok", "shared <pid:comm ...>" or "wedged <reason>".
npu_health() {
  local r h
  r=$(npu_wedge_reason)
  [[ -n $r ]] && { echo "wedged $r"; return; }
  h=$(npu_holders | tr '\n' ' ')
  [[ -n ${h// /} ]] && { echo "shared ${h% }"; return; }
  echo ok
}

holders_text() {
  local item out=()
  for item in $1; do out+=("${item#*:} (pid ${item%%:*})"); done
  local IFS=","; echo "${out[*]}" | sed 's/,/, /g'
}

# Run before anything that starts, stops or loads on the NPU.
npu_guard() {
  local h; h=$(npu_health)
  case $h in
    wedged*)
      die "The NPU driver is stuck: ${h#wedged }.
  Don't start, stop or load anything on the NPU now: that would get stuck too.
  Save your work and reboot. Shutdown may hang on the stuck process; if it sits on the
  logo for more than a few minutes, hold the power button." ;;
    shared*)
      ((FORCE)) || die "Another program has the NPU open: $(holders_text "${h#shared }").
  Two programs on the NPU can crash its driver. Close it (or start it with 'amd-npu hide-npu'),
  release the NPU first, or run this again with --force." ;;
  esac
}

not_released() {
  [[ -f $RELEASED ]] && die "The NPU is released. Run 'amd-npu resume' (or turn the NPU on in the bar card) first."
  return 0
}

# The installed proxy and unit files differ from this plugin version (enable applies them).
install_stale() {
  [[ -f $UNIT_FILE ]] || return 1
  ! cmp -s "$ROOT/lib/proxy.py" "$PROXY_DIR/proxy.py" ||
    ! cmp -s "$ROOT/lib/dictation-guard.py" "$GUARD" ||
    ! cmp -s "$ROOT/systemd/$UNIT" "$UNIT_FILE" ||
    ! cmp -s "$ROOT/systemd/$PROXY_UNIT" "$PROXY_UNIT_FILE" ||
    ! cmp -s "$ROOT/systemd/$PROXY_SOCKET" "$PROXY_SOCKET_FILE" ||
    { voxtype_on_npu && ! guard_installed; }
}

# The session's memlock ceiling is unlimited (the user service manager's hard limit).
memlock_ready() {
  local pid; pid=$(pgrep -u "$(id -u)" -x systemd | head -1)
  [[ -n $pid ]] && awk '/^Max locked memory/ { exit !($5 == "unlimited") }' "/proc/$pid/limits"
}

# --- server settings (server.env) ------------------------------------------

env_get() {
  local val=""
  [[ -f $SERVER_ENV ]] && val=$(grep -m1 "^$1=" "$SERVER_ENV" | cut -d= -f2- || true)
  echo "${val:-$2}"
}

# env_write <llm> <asr 0|1> <ctx> [embed 0|1]. Keeps the user's browser allowlist and, unless
# the fourth argument says otherwise, the embedding setting.
env_write() {
  local origins embed; origins=$(env_get AMD_NPU_ALLOWED_ORIGINS ""); embed=${4:-$(env_get FLM_EMBED 0)}
  mkdir -p "$STATE_DIR"
  printf '%s\n' \
    "# Written by amd-npu. FLM_LLM empty = Whisper only; FLM_ASR=0 = LLM has the NPU alone." \
    "# FLM_EMBED=1 = the embedding model ($EMBED_MODEL) is loaded too (amd-npu embed on|off)." \
    "# AMD_NPU_ALLOWED_ORIGINS: space-separated browser origins allowed to use the API" \
    "# (e.g. http://localhost:8080). Empty = web pages are refused." \
    "FLM_LLM=$1" "FLM_ASR=$2" "FLM_CTX=$3" "FLM_EMBED=$embed" "AMD_NPU_ALLOWED_ORIGINS=$origins" >"$SERVER_ENV"
}

# whisper | share | exclusive, from the saved settings
mode() {
  local llm; llm=$(env_get FLM_LLM "")
  if [[ -z $llm ]]; then echo whisper
  elif [[ $(env_get FLM_ASR 1) == 0 ]]; then echo exclusive
  else echo share; fi
}

# Restarts FastFlowLM and the proxy (PartOf=), and waits for the API. Returns 1 on failure.
try_restart_server() {
  systemctl --user daemon-reload
  systemctl --user restart "$UNIT" "$PROXY_UNIT" 2>/dev/null || return 1
  wait_for_server
}

restart_server() {
  try_restart_server || die "The NPU server didn't come up (journalctl --user -u $UNIT -u $PROXY_UNIT)."
}

# --- models -----------------------------------------------------------------

# LLMs only: Whisper and the embedding model are left out. ctx is FastFlowLM's default context;
# maxCtx, for downloaded models, is the model's own limit (max_position_embeddings in its config).
# Both come from files and a catalog amd-npu doesn't control, so only a plain positive whole number
# is kept (anything else becomes null): they end up in comparisons, and Bash arithmetic would run
# commands hidden in a string like "x[$(...)]" (HANCORE's review of 0.13.0).
# FastFlowLM 1.0.9 opens the NPU in every command except `validate`, before it even looks at the
# command (src/src/main.cpp), so `flm list` and `flm pull` would open it from a second process next
# to the server. They run with the NPU hidden instead (it treats a missing NPU as normal for these),
# and `flm list` output is kept in $XDG_RUNTIME_DIR until a model folder or flm itself changes.
flm_hidden() {
  if command -v bwrap >/dev/null; then
    bwrap --dev-bind / / --tmpfs /dev/accel --tmpfs /sys/class/accel --die-with-parent -- flm "$@"
  else
    flm "$@"
  fi
}

flm_list_json() {
  local dir=${XDG_RUNTIME_DIR:-} sig cache tmp out
  if [[ -n $dir && -d $dir && -O $dir ]]; then
    sig=$({ stat -c '%Y %s' "$(command -v flm)" 2>/dev/null; find "$FLM_MODELS" -maxdepth 2 -printf '%T@ %s %p\n' 2>/dev/null | sort; } | md5sum | cut -c1-32)
    cache="$dir/amd-npu-flm-list.$sig.json"
    [[ -s $cache ]] && { cat "$cache"; return 0; }
  fi
  out=$(flm_hidden list --json 2>/dev/null) || true
  if [[ -n ${cache:-} ]] && jq -e '.models | type == "array"' >/dev/null 2>&1 <<<"$out"; then
    tmp=$(mktemp "$dir/.amd-npu-flm-list.XXXXXX") && printf '%s\n' "$out" >"$tmp" &&
      rm -f "$dir"/amd-npu-flm-list.*.json && mv -f "$tmp" "$cache"
  fi
  printf '%s\n' "$out"
}

models_json() {
  flm_list_json | "$PY" -c '
import json, os, re, sys
def count(v):
    return v if type(v) is int and 0 < v < 100000000 else None
out = []
for m in json.load(sys.stdin).get("models", []):
    labels = m.get("label") or []
    if "embeddings" in labels or "realtime-transcription" in labels:
        continue
    most = None
    folder = re.search(r"FastFlowLM/([^/]+)", m.get("url", ""))
    if m.get("installed") and folder:
        try:
            with open(os.path.join(sys.argv[1], folder.group(1), "config.json")) as f:
                most = count(json.load(f).get("max_position_embeddings"))
        except (OSError, ValueError):
            pass
    if str(m.get("name", "")).split(":")[0].endswith("-flash"):
        most = count(m.get("default_context_length"))  # flash models have a fixed context
    d = m.get("details") or {}
    out.append({"name": m.get("name"), "installed": m.get("installed"), "footprint": m.get("footprint"),
                "ctx": count(m.get("default_context_length")), "maxCtx": most,
                "params": d.get("parameter_size"), "quant": d.get("quantization_level"),
                "think": d.get("think", False), "labels": labels})
print(json.dumps(out, separators=(",", ":")))' "$FLM_MODELS" 2>/dev/null || echo '[]'
}

model_info() { models_json | jq -c --arg m "$1" '.[] | select(.name == $m)'; }

# The embedding model's catalog entry (models_json leaves it out on purpose).
embed_info() { flm_list_json | jq -c --arg m "$EMBED_MODEL" '.models[] | select(.name == $m) | {name, installed, footprint}'; }
embed_installed() { [[ $(embed_info | jq -r '.installed // false') == true ]]; }
embed_enabled() { [[ $(env_get FLM_EMBED 0) == 1 ]]; }
# Whisper, the embedding model and an LLM don't fit on the NPU together (the third model's hardware
# context is refused). A shared LLM therefore pauses embeddings; this marker brings them back on
# unload/resume. NPU-only mode (no Whisper) keeps them.
EMBED_PAUSED="$STATE_DIR/embed-paused-for-llm"
embed_status_json() {
  jq -nc --arg name "$EMBED_MODEL" --argjson on "$(embed_enabled && echo true || echo false)" \
    --argjson dl "$(embed_installed && echo true || echo false)" --argjson paused "$([[ -f $EMBED_PAUSED ]] && echo true || echo false)" \
    '{name: $name, enabled: $on, installed: $dl, paused: $paused}'
}

# One embedding through the proxy; true when a vector comes back.
embed_answers() {
  local out; out=$(curl -s -m 60 -H 'content-type: application/json' \
    -d "{\"model\":\"$EMBED_MODEL\",\"input\":\"hello\"}" "$URL/v1/embeddings" 2>/dev/null || true)
  local n; n=$(jq -r '.data[0].embedding | length' <<<"$out" 2>/dev/null || echo 0)
  [[ $n =~ ^[0-9]+$ && $n -gt 0 ]]
}

loaded_llm() {
  local ps; ps=$(curl -s -m 3 "$URL/api/ps" 2>/dev/null || true)
  jq -r '.models[0].name // empty' <<<"$ps" 2>/dev/null | grep -v '^model-faker$' || true
}

server_pid() {
  local pid; pid=$(systemctl --user show -p MainPID --value "$UNIT" 2>/dev/null || echo 0)
  [[ $pid =~ ^[0-9]+$ && $pid != 0 && -r /proc/$pid/status ]] && echo "$pid" || echo 0
}

# Ordinary process memory. The NPU's model buffers are not included here.
server_rss_mb() {
  local pid; pid=$(server_pid)
  [[ $pid != 0 ]] || { echo 0; return; }
  awk '/VmRSS/{printf "%d", $2/1024}' "/proc/$pid/status"
}

# Memory held in NPU buffers (weights, KV cache), from the accel device's fdinfo.
server_npu_mb() {
  local pid; pid=$(server_pid)
  [[ $pid != 0 ]] || { echo 0; return; }
  cat /proc/"$pid"/fdinfo/* 2>/dev/null | awk '/^drm-total-memory:/{kb+=$2} END{printf "%d", kb/1024}'
}

# Loads (or swaps to) a model on the running server with a 1-token request.
# FastFlowLM answers 200 with {"error": "Failed to load … model!"} when a model can't be placed on
# the NPU, so success needs an actual reply in the body, not just the status code.
warm_llm() {
  local body
  body=$(curl -s -m 300 "$URL/v1/chat/completions" -H 'Content-Type: application/json' \
    -d "$(jq -nc --arg m "$1" '{model: $m, messages: [{role: "user", content: "hi"}], max_tokens: 1}')" || true)
  jq -e '.choices | length > 0' <<<"$body" >/dev/null 2>&1
}

require_downloaded_llm() {
  local info; info=$(model_info "$1")
  [[ -n $info ]] || die "'$1' isn't an NPU LLM FastFlowLM knows. See: amd-npu models"
  [[ $(jq -r .installed <<<"$info") == true ]] || die "'$1' isn't downloaded. Run: amd-npu pull $1"
}

# --- commands ---------------------------------------------------------------

cmd_check() {
  local gen fail=0
  step "Hardware"
  gen=$(npu_generation)
  case $gen in
    xdna2) ok "AMD XDNA2 NPU found (Strix / Krackan / Strix Halo / Gorgon Point)" ;;
    xdna1) bad "AMD XDNA1 NPU (Phoenix / Hawk Point): FastFlowLM needs XDNA2"; fail=1 ;;
    *) bad "No AMD NPU found"; fail=1 ;;
  esac
  if compgen -G "/dev/accel/accel*" >/dev/null; then ok "NPU device node present ($(ls /dev/accel | head -1))"; else bad "No /dev/accel device"; fail=1; fi
  if [[ -d /sys/module/amdxdna ]]; then ok "amdxdna kernel driver loaded"; else bad "amdxdna driver not loaded (kernel 6.14+ has it in-tree)"; fail=1; fi

  step "Software"
  local missing; missing=$(packages_missing)
  if [[ -z $missing ]]; then ok "Packages installed: ${PACKAGES[*]}"; else note "Not installed yet: $missing  (run: amd-npu install)"; fi
  if memlock_ready; then ok "Memlock ceiling unlimited for your session"; else note "Memlock ceiling not lifted yet (install sets it; reboot after)"; fi
  if command -v voxtype >/dev/null; then ok "Voxtype installed"; else note "Voxtype not installed (omarchy voxtype install) - the NPU server still works on its own"; fi
  return $fail
}

cmd_install() {
  cmd_check || die "This machine doesn't have a supported XDNA2 NPU."
  step "Install"
  echo "  This will (with sudo):"
  echo "   - install ${PACKAGES[*]} from the Arch repos"
  echo "   - allow unlimited locked memory for your account only ($MEMLOCK_LIMITS; the NPU runtime needs it)"
  local legacy=() f
  for f in "${LEGACY_MEMLOCK[@]}"; do [[ -f $f ]] && legacy+=("$f"); done
  ((${#legacy[@]})) && echo "   - delete drop-ins from older amd-npu versions that applied to every account: ${legacy[*]}"
  confirm "Continue?" || exit 1

  if command -v omarchy-pkg-add >/dev/null; then
    omarchy-pkg-add "${PACKAGES[@]}"
  else
    sudo pacman -S --needed "${PACKAGES[@]}"
  fi

  local me; me=$(id -un)
  sudo mkdir -p "$(dirname "$MEMLOCK_LIMITS")"
  printf '# Written by amd-npu: the AMD NPU runtime pins model weights.\n%s soft memlock unlimited\n%s hard memlock unlimited\n' "$me" "$me" |
    sudo tee "$MEMLOCK_LIMITS" >/dev/null
  ((${#legacy[@]})) && sudo rm -f "${legacy[@]}"
  ok "Packages installed; memlock lifted for $me"

  echo
  echo "Reboot, then run: amd-npu enable"
}

# install_unit <name> <destination>: copies a unit from the repo. When it replaces a different
# version, the old one is kept as a single .bak (older backups are pruned).
install_unit() {
  mkdir -p "$(dirname "$2")"
  if [[ -f $2 ]] && ! cmp -s "$2" "$ROOT/systemd/$1"; then
    rm -f "$2".bak.*
    cp -a "$2" "$2.bak.$(date +%s)"
    note "Updated $1 (previous version kept as a .bak)"
  fi
  cp "$ROOT/systemd/$1" "$2"
}

# Replaces the 0.1 service (flm-asr.service) with amd-npu.service.
migrate_legacy_unit() {
  local legacy="$CONFIG_HOME/systemd/user/$LEGACY_UNIT"
  [[ -f $legacy ]] || return 0
  systemctl --user disable --now "$LEGACY_UNIT" >/dev/null 2>&1 || true
  mv "$legacy" "$legacy.bak.$(date +%s)"
  note "Replaced $LEGACY_UNIT with $UNIT (old unit kept as a .bak)"
}

cmd_enable() {
  while (($#)); do case $1 in -y | --yes) YES=1 ;; *) die "Unknown option $1" ;; esac; shift; done
  cmd_check >/dev/null || die "No supported XDNA2 NPU (run: amd-npu check)."
  npu_guard
  [[ -z $(packages_missing) ]] || die "Packages missing (run: amd-npu install)."

  step "Validate the NPU stack"
  local validation fw
  if systemctl --user is-active --quiet "$UNIT" && server_up; then
    # A running server already proves the driver, firmware and memlock limit, and `flm validate`
    # would open the NPU from a second process next to it (re-running enable, Apply plugin update).
    fw=$(npu_firmware)
    ok "NPU server already running${fw:+ (firmware $fw)}; flm validate skipped"
  else
    # As a transient service with the service's own memlock limit; fails until the ceiling is lifted.
    validation=$(systemd-run --user --wait --pipe --quiet -p LimitMEMLOCK=infinity flm validate 2>&1 | sed 's/\x1b\[[0-9;]*m//g' || true)
    grep -q 'Memlock Limit: infinity' <<<"$validation" || die "Memlock is not unlimited yet. Reboot after 'amd-npu install'."
    grep -q 'NPU FW Version' <<<"$validation" || { echo "$validation"; die "flm validate failed."; }
    ok "$(grep -o 'NPU FW Version: .*' <<<"$validation")"
  fi

  step "Whisper model"
  # The sandboxed server can't download (and would hang trying), so missing models are fetched
  # here, after asking. A model whose files changed upstream also shows as not downloaded.
  if flm_list_json | jq -e --arg m "$WHISPER" '.models[] | select(.name == $m and .installed)' >/dev/null; then
    ok "$WHISPER present"
  else
    confirm "Download $WHISPER (~620 MB) from Hugging Face?" || die "Dictation needs $WHISPER."
    flm_hidden pull "$WHISPER"
  fi

  step "Service"
  migrate_legacy_unit
  local legacy_cors; legacy_cors=$(env_get FLM_CORS 0)
  # Rewritten every time: dictation needs Whisper on (an exclusive LLM becomes shared), and
  # settings from older versions (FLM_CORS) are dropped.
  local llm; llm=$(env_get FLM_LLM "")
  if [[ -n $llm ]] && [[ $(model_info "$llm" | jq -r '.installed // false') != true ]]; then
    note "$llm isn't fully downloaded any more; starting with Whisper only (amd-npu pull $llm)"
    llm=""
  fi
  local embed; embed=$(env_get FLM_EMBED 0)
  if [[ $embed == 1 ]] && ! embed_installed; then
    note "$EMBED_MODEL isn't downloaded any more; starting without embeddings (amd-npu pull $EMBED_MODEL)"
    embed=0
  fi
  env_write "$llm" 1 "$(env_get FLM_CTX -1)" "$embed"
  if [[ $legacy_cors == 1 ]]; then
    note "FLM_CORS=1 is retired. To let a browser chat UI in, list its origin in $SERVER_ENV:"
    note "  AMD_NPU_ALLOWED_ORIGINS=http://localhost:8080"
  fi
  install_unit "$UNIT" "$UNIT_FILE"
  install_unit "$PROXY_UNIT" "$PROXY_UNIT_FILE"
  install_unit "$PROXY_SOCKET" "$PROXY_SOCKET_FILE"
  mkdir -p "$PROXY_DIR"
  cp "$ROOT/lib/proxy.py" "$PROXY_DIR/proxy.py"
  cp "$ROOT/lib/dictation-guard.py" "$GUARD"
  systemctl --user daemon-reload
  systemctl --user enable "$UNIT" >/dev/null 2>&1
  if ! systemctl --user is-active --quiet "$PROXY_SOCKET"; then
    # Before 0.12 the proxy bound the port itself; systemd holds it from now on.
    systemctl --user stop "$PROXY_UNIT" 2>/dev/null || true
    systemctl --user enable --now "$PROXY_SOCKET" >/dev/null 2>&1 ||
      die "Couldn't hold $URL for this account ($(port_owner "$PORT") listener there; journalctl --user -u $PROXY_SOCKET)."
  fi
  systemctl --user enable "$PROXY_SOCKET" >/dev/null 2>&1
  ok "Port $PORT held for this account ($PROXY_SOCKET)"
  restart_server
  rm -f "$RELEASED"
  ok "Running; API on $URL ($(mode)), FastFlowLM behind it on 127.0.0.1:6669"

  step "Voxtype"
  if [[ -f $VOXTYPE_CONFIG ]]; then
    if voxtype_on_npu && [[ -z $(voxtype_cfg get mode) && -n $(voxtype_cfg get backend) ]]; then
      # Same setting under Voxtype 1.1's new name; drops the deprecation warning on every dictation.
      voxtype_backup
      voxtype_cfg set mode=remote -backend
      systemctl --user restart voxtype.service 2>/dev/null || true
      ok "Already pointed at the NPU; renamed Voxtype's deprecated 'backend' setting to 'mode'"
    elif voxtype_on_npu; then
      ok "Already pointed at the NPU"
    elif voxtype_exclusive_off; then
      ok "Dictation back on the NPU"
    else
      voxtype_changes_text
      if confirm "Point Voxtype at the NPU?"; then
        voxtype_use remote
        voxtype_guard_on
        ok "Dictation now transcribes on the NPU, with the dictation guard (previous values saved)"
      else
        note "Voxtype left as it was. Run 'amd-npu enable' again to switch it."
      fi
    fi
    if { voxtype_on_npu || [[ -f $VOX_EXCLUSIVE ]]; } && ! guard_installed; then
      echo "  Voxtype's config ($VOXTYPE_CONFIG), [output] section: pre_recording_command runs"
      echo "    amd-npu's dictation guard as each recording starts, cancelling it if another account"
      echo "    holds port $PORT. Any command you already have there runs after it; 'amd-npu disable'"
      echo "    or 'remove' takes the guard out again."
      if confirm "Add the dictation guard to Voxtype?"; then
        voxtype_guard_on
        ok "Dictation guard added (recordings stop if port $PORT isn't this account's)"
      else
        note "No guard: if another account takes port $PORT, it would receive your dictation."
      fi
    elif guard_installed; then
      ok "Dictation guard in place"
    fi
  else
    note "Voxtype isn't set up. Run 'omarchy voxtype install', then 'amd-npu enable' again."
  fi

  refresh_widget
  echo
  echo "Done. Hold F9 (or Super+Ctrl+X) to dictate."
}

cmd_status_json() {
  vox_cache_load
  local service=inactive server=false proxy=inactive whisper_dl=false llm="" llm_info="null" port_ok=true stale=false
  local health released=false; health=$(npu_health)
  [[ -f $RELEASED ]] && released=true
  local guard=false held=false
  systemctl --user is-active --quiet "$PROXY_UNIT" && proxy=active
  systemctl --user is-active --quiet "$PROXY_SOCKET" && held=true
  guard_installed && guard=true
  [[ $(port_owner "$PORT") == other ]] && port_ok=false
  install_stale && stale=true
  systemctl --user is-active --quiet "$UNIT" && service=active
  [[ -f $UNIT_FILE ]] || service=missing
  server_up && server=true
  [[ -d $WHISPER_DIR ]] && whisper_dl=true
  [[ $server == true ]] && llm=$(loaded_llm)
  [[ -n $llm ]] && llm_info=$(model_info "$llm")
  [[ -z $llm_info ]] && llm_info="null"
  jq -nc \
    --arg service "$service" --arg proxy "$proxy" --argjson server "$server" --argjson model "$whisper_dl" \
    --arg firmware "$(npu_firmware)" --arg backend "$(voxtype_backend)" \
    --arg last "$(last_latency)" --arg modelName "$WHISPER" --arg url "$URL" \
    --arg mode "$(mode)" --arg llm "$llm" --argjson llmInfo "$llm_info" \
    --argjson rss "$(server_rss_mb)" --argjson npuMb "$(server_npu_mb)" --argjson ctx "$(env_get FLM_CTX -1)" \
    --argjson models "$(models_json | jq -c '[.[] | select(.installed) | {name, params, footprint, ctx, maxCtx}]')" \
    --argjson portOk "$port_ok" --argjson stale "$stale" --argjson guard "$guard" --argjson portHeld "$held" \
    --arg health "$health" --argjson released "$released" --argjson embed "$(embed_status_json)" --arg f9 "$(f9_mode)" \
    '{service: $service, proxy: $proxy, server: $server, model: $model, modelName: $modelName, url: $url,
      portOk: $portOk, portHeld: $portHeld, guard: $guard, stale: $stale, released: $released, f9: $f9, npuHealth: ($health | split(" ")[0]),
      npuDetail: ($health | sub("^[a-z]+ ?"; "")),
      firmware: $firmware, backend: $backend, last: $last, mode: $mode, rssMb: $rss, npuMb: $npuMb,
      llm: (if $llm == "" then null else ($llmInfo + {name: $llm, ctxSetting: $ctx}) end),
      embed: $embed, downloaded: $models}'
}

last_latency() {
  journalctl --user -u voxtype.service --no-pager -n 200 2>/dev/null | grep -oP 'Remote transcription completed in \K[0-9.]+s' | tail -1 || true
}

# From the driver's sysfs attribute, which needs no device open. Older drivers without it: xrt-smi,
# which does open the NPU, so its answer is kept for the rest of the boot.
npu_firmware() {
  local f v cache
  for f in /sys/class/accel/accel*/device/fw_version; do
    [[ -r $f ]] || continue
    v=$(head -c 64 "$f" | tr -d '\n')
    [[ $v =~ ^[0-9A-Za-z._-]+$ ]] && { echo "$v"; return 0; }
  done
  cache=${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/amd-npu-fw}
  [[ -n $cache && -s $cache ]] && { cat "$cache"; return 0; }
  command -v xrt-smi >/dev/null || return 0
  v=$(xrt-smi examine 2>/dev/null | grep -oP 'NPU Firmware Version\s*:\s*\K\S+' | head -1 || true)
  [[ -n $v ]] || return 0
  [[ -n $cache ]] && printf '%s\n' "$v" >"$cache"
  echo "$v"
}

cmd_status() {
  [[ ${1:-} == --json ]] && { cmd_status_json; return; }
  vox_cache_load
  local ready=0
  step "AMD NPU status"
  if [[ $(port_owner "$PORT") == other ]]; then
    if guard_installed; then bad "Port $PORT is held by another account: the dictation guard cancels every recording until it's gone"
    else bad "Port $PORT is held by another account: don't dictate (it would get your audio and choose the typed text)"; fi
    ready=1
  fi
  install_stale && note "Plugin updated: run 'amd-npu enable' to apply the new proxy and service files"
  local health; health=$(npu_health)
  case $health in
    wedged*) bad "The NPU driver is stuck: ${health#wedged }. Reboot (save your work first; shutdown may hang)"; ready=1 ;;
    shared*) bad "Another program has the NPU open: $(holders_text "${health#shared }") (this can crash the driver)"; ready=1 ;;
  esac
  [[ -f $RELEASED ]] && note "The NPU is released (amd-npu resume brings it back)"
  if systemctl --user is-active --quiet "$UNIT"; then ok "$UNIT active"; else bad "$UNIT not running"; ready=1; fi
  if systemctl --user is-active --quiet "$PROXY_UNIT"; then ok "$PROXY_UNIT active (web pages refused)"; else bad "$PROXY_UNIT not running"; ready=1; fi
  if systemctl --user is-active --quiet "$PROXY_SOCKET"; then ok "Port $PORT held for this account ($PROXY_SOCKET)"
  else bad "$PROXY_SOCKET isn't holding port $PORT: run 'amd-npu enable'"; ready=1; fi
  if guard_installed; then ok "Dictation guard in Voxtype's pre_recording_command"
  elif voxtype_on_npu; then bad "No dictation guard in Voxtype: run 'amd-npu enable'"; ready=1; fi
  if server_up; then ok "Server answering on $URL"; else bad "Server not answering on $URL"; ready=1; fi
  if [[ -d $WHISPER_DIR ]]; then ok "Whisper model $WHISPER present"; else bad "Whisper model $WHISPER not downloaded"; ready=1; fi
  local fw; fw=$(npu_firmware)
  [[ -n $fw ]] && ok "NPU firmware $fw"
  case $(voxtype_backend) in
    remote) if voxtype_on_npu; then ok "Voxtype dictates on the NPU"; else note "Voxtype uses another remote server ($(voxtype_cfg get remote_endpoint))"; ready=1; fi ;;
    -) note "Voxtype not set up" ;;
    *) note "Voxtype dictates on its CPU model"; [[ $(mode) == exclusive ]] || ready=1 ;;
  esac
  local last; last=$(last_latency)
  [[ -n $last ]] && ok "Last dictation transcribed in $last"

  step "Local model"
  local llm=""
  server_up && llm=$(loaded_llm)
  if [[ -n $llm ]]; then
    local info; info=$(model_info "$llm")
    ok "$llm loaded ($(jq -r '"\(.params) \(.quant), ~\(.footprint) GB"' <<<"$info"))"
    case $(mode) in
      exclusive) note "NPU only: dictation is on the CPU until 'amd-npu unload'" ;;
      *) ok "Sharing the NPU with Whisper (dictation waits while the LLM is answering)" ;;
    esac
    ok "API: $URL/v1 (OpenAI) and $URL/api (Ollama)"
    ok "Memory: $(server_npu_mb) MB in NPU buffers + $(server_rss_mb) MB process"
  else
    note "No LLM loaded (amd-npu load <model>)"
  fi
  return $ready
}

# Quiet live check of Whisper: prints "ok <seconds>" or "fail <http code>".
cmd_ping() {
  local wav body code
  wav=$(mktemp --suffix=.wav) body=$(mktemp)
  "$PY" -c "import wave,sys; w=wave.open(sys.argv[1],'wb'); w.setnchannels(1); w.setsampwidth(2); w.setframerate(16000); w.writeframes(b'\0\0'*16000); w.close()" "$wav"
  code=$(curl -s -m 60 -o "$body" -w '%{http_code} %{time_total}' "$URL/v1/audio/transcriptions" -F "file=@$wav" -F "model=$WHISPER" || true)
  # With Whisper off the server still answers 200, with a body of `null`.
  if [[ ${code%% *} == 200 ]] && jq -e 'type == "object" and has("text")' "$body" >/dev/null 2>&1; then
    echo "ok ${code#* }"
  else
    [[ ${code%% *} == 200 ]] && echo "fail no-whisper" || echo "fail ${code%% *}"
    rm -f "$wav" "$body"
    return 1
  fi
  rm -f "$wav" "$body"
}

cmd_doctor() {
  vox_cache_load
  cmd_check || true
  cmd_status || true
  local fail=0
  step "Browser protection"
  local code headers
  code=$(curl -s -m 5 -o /dev/null -w '%{http_code}' -H 'Origin: https://example.com' "$URL/api/version" || true)
  if [[ $code == 403 ]]; then ok "A web page's request is refused (403)"; else bad "A web page's request got HTTP $code (expected 403)"; fail=1; fi
  code=$(curl -s -m 5 -o /dev/null -w '%{http_code}' -H 'Content-Type: text/plain' -d '{}' "$URL/v1/chat/completions" || true)
  if [[ $code == 415 ]]; then ok "A plain-text POST is refused (415)"; else bad "A plain-text POST got HTTP $code (expected 415)"; fail=1; fi
  headers=$(curl -s -m 5 -D - -o /dev/null "$URL/api/version" || true)
  if grep -qi '^access-control-allow-origin' <<<"$headers"; then bad "Responses still carry a CORS header"; fail=1; else ok "No wildcard CORS header on responses"; fi
  code=$(curl -s -m 5 -o /dev/null -w '%{http_code}' -H 'Content-Type: application/json' -d '{"model":"amd-npu-doctor-probe:none"}' "$URL/api/pull" || true)
  if [[ $code == 404 ]]; then ok "Model downloads through the API are refused (404)"; else bad "POST /api/pull got HTTP $code (expected 404)"; fail=1; fi
  local origins; origins=$(env_get AMD_NPU_ALLOWED_ORIGINS "")
  [[ " $origins " == *" * "* ]] && note "AMD_NPU_ALLOWED_ORIGINS contains '*': ignored, since it would let every website in"
  [[ -n ${origins// /} ]] && note "Allowed browser origins: $origins"

  step "Live request"
  if [[ $(mode) == exclusive ]]; then note "Whisper is off while an LLM has the NPU alone"; return $fail; fi
  local result; result=$(cmd_ping || true)
  if [[ $result == ok* ]]; then ok "Transcription endpoint OK (1 s of silence in ${result#ok }s)"; else bad "Transcription request failed (HTTP ${result#fail })"; return 1; fi
  return $fail
}

cmd_models() {
  local json; json=$(models_json)
  if [[ ${1:-} == --json ]]; then echo "$json"; return; fi
  printf '\n  %-22s %-7s %-6s %8s  %s\n' MODEL PARAMS QUANT MEMORY DOWNLOADED
  jq -r '.[] | [.name, .params, .quant, "\(.footprint) GB", (if .installed then "yes" else "" end)] | @tsv' <<<"$json" |
    while IFS=$'\t' read -r n p q f i; do printf '  %-22s %-7s %-6s %8s  %s\n' "$n" "$p" "$q" "$f" "$i"; done
  echo
  echo "  Download with: amd-npu pull <model>    Load with: amd-npu load <model> [--exclusive]"
  echo "  Embeddings:    amd-npu pull $EMBED_MODEL, then amd-npu embed on"
}

# amd-npu embed on|off|status: the embedding model next to Whisper and any LLM. It answers
# /v1/embeddings through the proxy. Like everything on this server, a request waits while another
# one runs, so a big batch holds up dictation for a moment; the setting survives unload/resume.
cmd_embed() {
  case ${1:-status} in
    status)
      local st=off; embed_enabled && st=on
      if embed_installed; then echo "embeddings: $st ($EMBED_MODEL downloaded)"
      else echo "embeddings: $st ($EMBED_MODEL not downloaded: amd-npu pull $EMBED_MODEL)"; fi
      ;;
    on)
      [[ -f $UNIT_FILE ]] || die "The NPU server isn't set up (amd-npu enable)."
      not_released
      npu_guard
      embed_installed || die "$EMBED_MODEL isn't downloaded. Run: amd-npu pull $EMBED_MODEL"
      if embed_enabled && server_up && embed_answers; then ok "Embeddings already on ($EMBED_MODEL)"; return; fi
      [[ $(mode) == share ]] && die "The NPU can't hold Whisper, embeddings and $(env_get FLM_LLM "") together. Unload the model (embeddings come back on their own), or load it NPU-only."
      step "Load $EMBED_MODEL next to Whisper"
      local saved_env; saved_env=$(cat "$SERVER_ENV" 2>/dev/null || true)
      env_write "$(env_get FLM_LLM "")" "$(env_get FLM_ASR 1)" "$(env_get FLM_CTX -1)" 1
      restart_or_rollback "$EMBED_MODEL" "$saved_env"
      embed_answers || rollback_and_die "$EMBED_MODEL" "$saved_env"
      ok "$EMBED_MODEL answers at $URL/v1/embeddings"
      if [[ $(env_get FLM_ASR 1) == 1 ]]; then
        if cmd_ping >/dev/null; then ok "Whisper still answering"; else note "Whisper isn't answering (journalctl --user -u $UNIT)"; fi
      fi
      refresh_widget
      ;;
    off)
      [[ -f $UNIT_FILE ]] || die "The NPU server isn't set up (amd-npu enable)."
      not_released
      npu_guard
      if [[ -f $EMBED_PAUSED ]]; then rm -f "$EMBED_PAUSED"; ok "Embeddings stay off after you unload the model"; return; fi
      embed_enabled || { ok "Embeddings already off"; return; }
      step "Unload $EMBED_MODEL"
      env_write "$(env_get FLM_LLM "")" "$(env_get FLM_ASR 1)" "$(env_get FLM_CTX -1)" 0
      if systemctl --user is-enabled --quiet "$UNIT" 2>/dev/null || systemctl --user is-active --quiet "$UNIT"; then restart_server; fi
      ok "Embeddings off"
      refresh_widget
      ;;
    *) die "Usage: amd-npu embed on|off|status" ;;
  esac
}

cmd_pull() {
  local m=${1:-}; [[ -n $m ]] || die "Usage: amd-npu pull <model>"
  local info
  if [[ $m == "$EMBED_MODEL" ]]; then info=$(embed_info); else info=$(model_info "$m"); fi
  [[ -n $info ]] || die "'$m' isn't an NPU LLM FastFlowLM knows (or $EMBED_MODEL). See: amd-npu models"
  if [[ $(jq -r .installed <<<"$info") == true ]]; then ok "$m is already downloaded"; return; fi
  confirm "Download $m (~$(jq -r .footprint <<<"$info") GB in memory once loaded)?" || exit 1
  flm_hidden pull "$m"
  refresh_widget
}

cmd_load() {
  local m="" exclusive=0 ctx
  ctx=$(env_get FLM_CTX -1)
  while (($#)); do
    case $1 in
      --exclusive) exclusive=1 ;;
      --share) exclusive=0 ;;
      --ctx) ctx=${2:?--ctx needs a value}; shift ;;
      -y | --yes) YES=1 ;;
      -*) die "Unknown option $1" ;;
      *) m=$1 ;;
    esac
    shift
  done
  [[ -n $m ]] || die "Usage: amd-npu load <model> [--exclusive] [--ctx N]"
  not_released
  npu_guard
  # FastFlowLM's minimum context is 512; a value it rejects would stop the server.
  [[ $ctx == -1 || ( $ctx =~ ^[0-9]{3,7}$ && $ctx -ge 512 ) ]] || die "--ctx must be -1 (the model's default) or a whole number from 512 up"
  require_downloaded_llm "$m"
  local most; most=$(model_info "$m" | jq -r '.maxCtx // empty')
  # Digits only before any arithmetic (see models_json); $ctx passed the same check above.
  [[ $most =~ ^[0-9]{1,8}$ ]] || most=""
  [[ $ctx == -1 || -z $most || $ctx -le $most ]] || die "$m takes up to $most tokens of context (--ctx $most or less)"
  local prev prev_ctx saved_env
  prev=$(mode)
  prev_ctx=$(env_get FLM_CTX -1)
  saved_env=$(cat "$SERVER_ENV" 2>/dev/null || true)

  if (( exclusive )); then
    step "Load $m on the NPU alone"
    echo "  While $m has the NPU, dictation uses Voxtype's CPU model (lower accuracy)."
    echo "  Run 'amd-npu unload' (or use the bar card) to bring Whisper back."
    confirm "Continue?" || exit 1
    env_write "$m" 0 "$ctx"
    restart_or_rollback "$m" "$saved_env"
    if voxtype_exclusive_on; then
      ok "$m has the NPU; dictation is on the CPU"
      notify "Dictation is on the CPU" "$m is using the NPU. Unload it to bring Whisper back."
    else
      ok "$m has the NPU"
    fi
  else
    step "Load $m next to Whisper"
    local embed_paused_now=0
    if embed_enabled; then
      note "Embeddings pause while $m shares the NPU with Whisper (the NPU can't hold all three); unloading brings them back"
      touch "$EMBED_PAUSED"
      embed_paused_now=1
    fi
    if ((embed_paused_now)); then env_write "$m" 1 "$ctx" 0; else env_write "$m" 1 "$ctx"; fi
    # Live swap when the running server already has Whisper, the same context setting and no
    # embeddings change; otherwise restart it with the new settings.
    if [[ $prev != exclusive && $ctx == "$prev_ctx" ]] && ((!embed_paused_now)) && systemctl --user is-active --quiet "$UNIT" && server_up && warm_llm "$m"; then
      ok "Swapped to $m without restarting Whisper"
    else
      restart_or_rollback "$m" "$saved_env"
      warm_llm "$m" || rollback_and_die "$m" "$saved_env"
      ok "$m loaded"
    fi
    # A failed or odd load can reset the NPU device and take Whisper with it.
    if ! cmd_ping >/dev/null; then
      note "Whisper stopped answering; restarting the server"
      restart_server
      cmd_ping >/dev/null || die "Whisper didn't come back (journalctl --user -u $UNIT)."
    fi
    ok "Whisper still answering"
    if [[ $prev == exclusive ]] && voxtype_exclusive_off; then
      notify "Dictation is back on the NPU" "$m now shares the NPU with Whisper."
    fi
  fi
  refresh_widget
  echo
  echo "API: $URL/v1 (model \"$m\")   Chat: amd-npu chat"
}

# If the server won't come up with the new settings, put the previous server.env back,
# restart with it, and stop with an error, so a bad load never leaves the service down.
rollback_and_die() {
  printf '%s\n' "$2" >"$SERVER_ENV"
  # The restored settings say whether embeddings are on; a pause marker for them no longer applies.
  [[ $(env_get FLM_EMBED 0) == 1 ]] && rm -f "$EMBED_PAUSED"
  try_restart_server || true
  refresh_widget
  die "$1 didn't start on the NPU; previous settings restored (journalctl --user -u $UNIT)."
}

restart_or_rollback() {
  try_restart_server || rollback_and_die "$1" "$2"
}

cmd_unload() {
  not_released
  npu_guard
  local prev; prev=$(mode)
  step "Unload the local model"
  if [[ -f $EMBED_PAUSED ]]; then
    env_write "" 1 -1 1
    rm -f "$EMBED_PAUSED"
    ok "Embeddings back on ($EMBED_MODEL)"
  else
    env_write "" 1 -1
  fi
  if systemctl --user is-enabled --quiet "$UNIT" 2>/dev/null || systemctl --user is-active --quiet "$UNIT"; then
    restart_server
    ok "Whisper only on the NPU"
  fi
  if [[ $prev == exclusive ]] && voxtype_exclusive_off; then
    ok "Dictation back on the NPU"
    notify "Dictation is back on the NPU" "The local model was unloaded; Whisper has the NPU again."
  fi
  refresh_widget
}

cmd_chat() {
  local m=${1:-} think=0
  [[ ${2:-} == --think || ${1:-} == --think ]] && think=1
  [[ $m == --think ]] && m=""
  not_released
  server_up || die "The NPU server isn't running (amd-npu enable)."
  [[ -n $m ]] || m=$(loaded_llm)
  [[ -n $m ]] || die "No model loaded. Load one first (amd-npu load <model>) or name it: amd-npu chat <model>"
  require_downloaded_llm "$m"
  [[ $m == "$(loaded_llm)" ]] || { npu_guard; cmd_load "$m" >/dev/null; }
  "$PY" "$ROOT/lib/chat.py" "$URL" "$m" "$think"
}

# Measures the loaded LLM: prints human text, or "ok <prefill> <decode> <tokens>" with --raw.
cmd_bench_llm() {
  local m; m=$(loaded_llm)
  [[ -n $m ]] || { [[ ${1:-} == --raw ]] && echo "fail none" && return 1; die "No model loaded."; }
  local resp
  resp=$(curl -s -m 300 "$URL/v1/chat/completions" -H 'Content-Type: application/json' \
    -d "$(jq -nc --arg m "$m" '{model: $m, max_tokens: 200, chat_template_kwargs: {enable_thinking: false},
          messages: [{role: "user", content: "In about 150 words, explain what a neural processing unit is."}]}')" || true)
  local prefill decode tokens
  prefill=$(jq -r '.usage.prefill_speed_tps // empty' <<<"$resp" 2>/dev/null || true)
  decode=$(jq -r '.usage.decoding_speed_tps // empty' <<<"$resp" 2>/dev/null || true)
  tokens=$(jq -r '.usage.completion_tokens // empty' <<<"$resp" 2>/dev/null || true)
  if [[ -z $decode ]]; then [[ ${1:-} == --raw ]] && echo "fail request" && return 1; die "Benchmark request failed."; fi
  if [[ ${1:-} == --raw ]]; then
    printf 'ok %.1f %.1f %s\n' "$prefill" "$decode" "$tokens"
  else
    ok "$m: generation $(printf '%.1f' "$decode") tok/s, prompt $(printf '%.0f' "$prefill") tok/s ($tokens tokens)"
  fi
}

cmd_disable() {
  npu_guard
  step "Disable the NPU server"
  voxtype_guard_off
  voxtype_restore
  ok "Voxtype's own settings restored"
  systemctl --user disable --now "$UNIT" >/dev/null 2>&1 || true
  # Voxtype no longer sends audio to the port, so it can be let go.
  systemctl --user disable --now "$PROXY_SOCKET" "$PROXY_UNIT" >/dev/null 2>&1 || true
  rm -f "$RELEASED"
  ok "$UNIT stopped; the NPU is free"
  refresh_widget
}

# Frees the NPU and its memory (Whisper and any LLM) until `resume`, across reboots. Dictation
# moves to Voxtype's CPU model if it was on the NPU, and comes back on resume.
cmd_release() {
  [[ -f $UNIT_FILE ]] || die "The NPU server isn't set up (amd-npu enable)."
  [[ -f $RELEASED ]] && { ok "The NPU is already released"; return; }
  npu_guard
  step "Release the NPU"
  local held=""
  [[ $(server_pid) != 0 ]] && held=" ($(server_npu_mb) MB of NPU buffers and $(server_rss_mb) MB of memory freed)"
  [[ -f $VOX_EXCLUSIVE ]] || voxtype_exclusive_on || true
  mkdir -p "$STATE_DIR" && touch "$RELEASED"
  systemctl --user disable --now "$UNIT" >/dev/null 2>&1 || true
  local i
  for i in $(seq 1 15); do [[ $(server_pid) == 0 ]] && break; sleep 1; done
  [[ $(server_pid) == 0 ]] || note "FastFlowLM is taking a while to exit; check 'amd-npu status'"
  ok "NPU released$held"
  [[ -f $VOX_EXCLUSIVE ]] && ok "Dictation uses Voxtype's CPU model until 'amd-npu resume'"
  local others; others=$(npu_holders | tr '
' ' ')
  [[ -n ${others// /} ]] && note "Still holding the NPU: $(holders_text "${others% }")"
  notify "NPU released" "The NPU and its memory are free. Turn it back on from the bar card or with 'amd-npu resume'."
  refresh_widget
}

cmd_resume() {
  [[ -f $UNIT_FILE ]] || die "The NPU server isn't set up (amd-npu enable)."
  npu_guard
  step "Resume the NPU"
  if [[ -f $EMBED_PAUSED ]]; then env_write "" 1 "$(env_get FLM_CTX -1)" 1; rm -f "$EMBED_PAUSED"; else env_write "" 1 "$(env_get FLM_CTX -1)"; fi
  systemctl --user enable "$UNIT" >/dev/null 2>&1
  restart_server
  rm -f "$RELEASED"
  ok "Whisper is back on the NPU"
  voxtype_exclusive_off && ok "Dictation back on the NPU"
  notify "NPU back on" "Dictation is on the NPU again."
  refresh_widget
}

# F9 mode: "hold" (Omarchy's push-to-talk) or "toggle" (tap to start, tap to stop).
f9_mode() { [[ -f $F9_TOGGLE ]] && echo toggle || echo hold; }

cmd_f9() {
  case ${1:-status} in
    status) f9_mode; return ;;
    toggle)
      [[ $(f9_mode) == toggle ]] && { ok "F9 already toggles dictation"; return; }
      mkdir -p "$(dirname "$F9_TOGGLE")"
      cp "$ROOT/hypr/amd-npu-f9-toggle.lua" "$F9_TOGGLE" ;;
    hold)
      [[ $(f9_mode) == hold ]] && { ok "F9 is already push-to-talk"; return; }
      rm -f "$F9_TOGGLE" ;;
    *) die "Usage: amd-npu f9 [toggle|hold|status]" ;;
  esac
  hyprctl reload >/dev/null 2>&1 || true
  local errors; errors=$(hyprctl configerrors 2>/dev/null | grep -v '^$' || true)
  if [[ -n $errors && $1 == toggle ]]; then
    rm -f "$F9_TOGGLE"
    hyprctl reload >/dev/null 2>&1 || true
    die "Hyprland rejected the F9 toggle, so push-to-talk was kept: $errors"
  fi
  local binds; binds=$(hyprctl binds -j 2>/dev/null | jq -r '[.[] | select(.key == "F9" and .modmask == 0)] | length' 2>/dev/null || echo "?")
  if [[ $1 == toggle ]]; then
    ok "F9 now toggles dictation: tap to start, tap again to stop ($binds F9 binding)"
  else
    ok "F9 is push-to-talk again: hold to record, release to stop ($binds F9 bindings)"
  fi
  refresh_widget
}

# Runs a program with the NPU hidden, so ROCm (which opens every AIE device it finds) uses the GPU
# only and can't disturb the NPU server.
cmd_hide_npu() {
  (($#)) || die "Usage: amd-npu hide-npu <command> [args]"
  command -v bwrap >/dev/null || die "bubblewrap isn't installed (omarchy pkg add bubblewrap)."
  exec bwrap --dev-bind / / --tmpfs /dev/accel --tmpfs /sys/class/accel --die-with-parent -- "$@"
}

cmd_remove() {
  cmd_disable
  step "Remove"
  rm -f "$UNIT_FILE" "$PROXY_UNIT_FILE" "$PROXY_SOCKET_FILE" "$UNIT_FILE".bak.* "$PROXY_UNIT_FILE".bak.* "$PROXY_SOCKET_FILE".bak.*
  if [[ -f $F9_TOGGLE ]]; then
    rm -f "$F9_TOGGLE"
    hyprctl reload >/dev/null 2>&1 || true
    ok "F9 is push-to-talk again"
  fi
  rm -rf "$PROXY_DIR"
  systemctl --user daemon-reload
  ok "Removed $UNIT and $PROXY_UNIT"
  if [[ -d $WHISPER_DIR ]] && confirm "Delete the Whisper model ($(du -sh "$WHISPER_DIR" | cut -f1))?"; then
    rm -rf "$WHISPER_DIR"
    ok "Whisper model deleted"
  fi
  if confirm "Delete downloaded LLMs and settings ($FLM_MODELS, $STATE_DIR)?"; then
    rm -rf "$FLM_MODELS" "$STATE_DIR"
    ok "Models and settings deleted"
  fi
  local old=() f
  for f in "$VOXTYPE_CONFIG".bak.*; do [[ $f =~ \.bak\.[0-9]{10}$ ]] && old+=("$f"); done
  if ((${#old[@]})) && confirm "Delete ${#old[@]} Voxtype config backups made by older amd-npu versions (config.toml.bak.<number>)?"; then
    rm -f "${old[@]}"
    ok "Old backups deleted"
  fi
  if confirm "Also uninstall ${PACKAGES[*]} and the memlock setting (sudo)?"; then
    sudo pacman -Rns "${PACKAGES[@]}" || true
    sudo rm -f "$MEMLOCK_LIMITS" "${LEGACY_MEMLOCK[@]}"
    ok "Packages and memlock setting removed (reboot to reset the limit)"
  fi
  refresh_widget
}

# One word for the bar card, which can't run setup itself (Omarchy plugins have no install hooks):
# unsupported, driver, install, reboot, enable, or installed.
cmd_setup_state() {
  [[ $(npu_generation) == xdna2 ]] || { echo unsupported; return; }
  if ! compgen -G "/dev/accel/accel*" >/dev/null || [[ ! -d /sys/module/amdxdna ]]; then echo driver; return; fi
  [[ -z $(packages_missing) ]] || { echo install; return; }
  memlock_ready || { echo reboot; return; }
  if systemctl --user cat "$UNIT" >/dev/null 2>&1; then echo installed; else echo enable; fi
}

cmd_help() {
  cat <<EOF
amd-npu $VERSION - dictation and small local LLMs on the AMD XDNA2 NPU

Setup
  check                 Is this machine supported? What's installed?
  install               NPU runtime + FastFlowLM + memlock limit (sudo, then reboot)
  enable [--yes]        Download Whisper, start the NPU server, point Voxtype at it
                        (asks before changing Voxtype's config; --yes skips asking)
  disable / remove      Stop, putting Voxtype's own settings back / uninstall
  release / resume      Free the NPU and its memory (dictation on the CPU model) / bring it back
  hide-npu <command>    Run a program (e.g. a ROCm app) with the NPU hidden from it
  setup-state           One word for the bar card: unsupported, driver, install, reboot,
                        enable or installed

Dictation
  f9 [toggle|hold|status]
                        Tap F9 to start and again to stop, or hold it (Omarchy's default)
  status [--json]       What's running on the NPU
  doctor                status + a live transcription request
  ping                  Quiet Whisper check: "ok <seconds>" or "fail <code>"

Local models
  models [--json]       NPU LLMs FastFlowLM offers, and which are downloaded
  pull <model>          Download a model
  load <model>          Load next to Whisper (dictation keeps working; it waits while
                        the LLM is answering)
  load <model> --exclusive
                        Give the LLM the NPU alone; dictation falls back to the CPU model
  unload                Drop the LLM; Whisper-only again (and back on the NPU)
  chat [model] [--think]
                        Chat in the terminal with the loaded model
  bench-llm [--raw]     Measure the loaded model's generation speed
  embed on|off|status   Load the embedding model ($EMBED_MODEL, ~0.6 GB) next to Whisper
                        for local RAG tools: POST $URL/v1/embeddings (it waits while
                        another request is running, like everything on this server)

Commands that start, stop or load on the NPU refuse while another program holds it
(--force overrides) and while the NPU driver is stuck (reboot).

API while a model is loaded: $URL/v1 (OpenAI) and $URL/api (Ollama).
Web pages are refused unless their origin is in AMD_NPU_ALLOWED_ORIGINS ($SERVER_ENV).
EOF
}

# --force (any position, except after hide-npu's command) lets commands run while another program
# holds the NPU.
if [[ ${1:-} != hide-npu ]]; then
  args=()
  for a in "$@"; do if [[ $a == --force ]]; then FORCE=1; else args+=("$a"); fi; done
  set -- "${args[@]+"${args[@]}"}"
fi

case ${1:-help} in
  check | install | enable | status | doctor | ping | models | pull | load | unload | chat | embed | disable | remove | release | resume | help) cmd="cmd_$1"; shift; "$cmd" "$@" ;;
  bench-llm) shift; cmd_bench_llm "$@" ;;
  setup-state) shift; cmd_setup_state "$@" ;;
  hide-npu) shift; cmd_hide_npu "$@" ;;
  f9) shift; cmd_f9 "$@" ;;
  -h | --help) cmd_help ;;
  -v | --version) echo "$VERSION" ;;
  *) cmd_help; exit 1 ;;
esac
